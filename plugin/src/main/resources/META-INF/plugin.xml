<idea-plugin>
    <id>com.cloneguard</id>
    <name>CloneGuard</name>
    <vendor email="cloneguard@dev.com" url="">CloneGuard</vendor>
    <version>1.0.0</version>

    <description><![CDATA[
        CloneGuard detects all 4 types of code clones from JetBrains AI inline suggestions
        BEFORE the developer accepts them. Also supports full-file scanning and GitHub PR integration.
        <br><br>
        <b>Clone Types Detected:</b><br>
        • Type 1 — Exact Clone (identical code)<br>
        • Type 2 — Renamed Clone (same structure, different variable names)<br>
        • Type 3 — Near-Miss Clone (similar structure, minor modifications)<br>
        • Type 4 — Semantic Clone (same intent, different implementation)<br>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <!-- ═══════════════════════════════════════════════
             SCENARIO 1: Ghost Text Listener
             Intercepts JetBrains AI inline suggestions
             ═══════════════════════════════════════════════ -->
        <editorFactoryListener
            implementation="com.cloneguard.listeners.InlineSuggestionListener"/>

        <!-- ═══════════════════════════════════════════════
             SCENARIO 1: Notification for unresolved pasted clones
             Shows a persistent notification when the user chose
             "Accept Anyway" or "Dismiss" on a detected paste-clone,
             with a "Refactor with Extract Method" action button —
             using the same engine Scenario 2's tool window button
             uses. Replaces an earlier gutter-icon (LineMarkerProvider)
             approach that, after extensive debugging, was found to
             never be invoked by the platform in this environment
             even in a minimal unconditional test — notifications are
             a simpler, more reliable mechanism with no equivalent
             extension-point fragility.
             ═══════════════════════════════════════════════ -->
        <notificationGroup id="CloneGuard" displayType="STICKY_BALLOON" isLogByDefault="true"/>

        <!-- ═══════════════════════════════════════════════
             SCENARIO 2: Tool Window for Scan Results
             Shows clone groups panel at bottom of IDE
             ═══════════════════════════════════════════════ -->
        <toolWindow
            id="CloneGuard"
            anchor="bottom"
            factoryClass="com.cloneguard.ui.CloneGuardToolWindowFactory"
            icon="/icons/cloneguard.svg"/>

        <!-- Application-level services -->
        <!--
            CloneGuardSettings: new (issue 4.2), persists the
            configurable server URL, replacing the old hardcoded
            constant in PythonServerClient.
        -->
        <applicationService
            serviceImplementation="com.cloneguard.settings.CloneGuardSettings"/>

        <!--
            FIX (professor-flagged, 2.3): CloneIndexService was
            registered here as an applicationService, but the class
            itself was changed to @Service(Service.Level.PROJECT) to fix
            the cross-project data leak the professor identified (a
            paste in Project A could match a function from Project B,
            since the index was shared IDE-wide). This XML registration
            must match that annotation: left as applicationService,
            the registration and the actual service level disagree,
            which either breaks plugin startup or silently reintroduces
            the exact bug 2.3 was meant to fix. Moved to projectService
            below, alongside the plugin's other project-scoped services.
        -->

        <!-- Settings/Preferences panel: new (issue 4.2) -->
        <applicationConfigurable
            parentId="tools"
            instance="com.cloneguard.settings.CloneGuardConfigurable"
            id="com.cloneguard.settings.CloneGuardConfigurable"
            displayName="CloneGuard"/>

        <!-- Project-level services -->
        <projectService
            serviceImplementation="com.cloneguard.services.FileScannerService"/>

        <projectService
            serviceImplementation="com.cloneguard.services.PythonServerClient"/>

        <!-- Moved from applicationService above: see FIX note (issue 2.3) -->
        <projectService
            serviceImplementation="com.cloneguard.services.CloneIndexService"/>

    </extensions>

    <actions>
        <!-- ═══════════════════════════════════════════════
             SCENARIO 2: Scan Current File action
             Under Tools → CloneGuard → Scan Current File
             ═══════════════════════════════════════════════ -->
        <group id="CloneGuardMenu" text="CloneGuard" description="CloneGuard actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="CloneGuard.ScanFile"
                    class="com.cloneguard.ui.ScanFileAction"
                    text="Scan Current File"
                    description="Scan the current file for all 4 clone types">
                <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl G"/>
            </action>

            <action id="CloneGuard.IndexFile"
                    class="com.cloneguard.ui.IndexFileAction"
                    text="Index Current File"
                    description="Index functions in the current file for clone detection"/>
        </group>
    </actions>

</idea-plugin>