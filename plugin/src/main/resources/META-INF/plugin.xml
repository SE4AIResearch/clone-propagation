<idea-plugin>
    <id>com.cloneguard</id>
    <name>CloneGuard</name>
    <vendor email="cloneguard@dev.com" url="">CloneGuard</vendor>
    <version>1.0.1</version>

    <description><![CDATA[
        CloneGuard detects all 4 types of code clones from JetBrains AI inline suggestions
        BEFORE the developer accepts them. Also supports full-file scanning and GitHub PR integration.
        <br><br>
        <b>Clone Types Detected:</b><br>
        • Type 1 — Exact Clone (identical code)<br>
        • Type 2 — Renamed Clone (same structure, different variable names)<br>
        • Type 3 — Near-Miss Clone (similar structure, minor modifications)<br>
        • Type 4 — Semantic Clone (same intent, different implementation)<br>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <extensions defaultExtensionNs="com.intellij">

        <editorFactoryListener
            implementation="com.cloneguard.listeners.InlineSuggestionListener"/>

        <notificationGroup id="CloneGuard" displayType="STICKY_BALLOON" isLogByDefault="true"/>

        <toolWindow
            id="CloneGuard"
            anchor="bottom"
            factoryClass="com.cloneguard.ui.CloneGuardToolWindowFactory"
            icon="/icons/cloneguard.svg"/>

        <applicationService
            serviceImplementation="com.cloneguard.settings.CloneGuardSettings"/>

        <applicationConfigurable
            parentId="tools"
            instance="com.cloneguard.settings.CloneGuardConfigurable"
            id="com.cloneguard.settings.CloneGuardConfigurable"
            displayName="CloneGuard"/>

        <projectService
            serviceImplementation="com.cloneguard.services.FileScannerService"/>

        <projectService
            serviceImplementation="com.cloneguard.services.PythonServerClient"/>

        <projectService
            serviceImplementation="com.cloneguard.services.CloneIndexService"/>

        <projectService
            serviceImplementation="com.cloneguard.services.MetricsTrackerService"/>

        <postStartupActivity
            implementation="com.cloneguard.startup.CloneGuardStartupActivity"/>

    </extensions>

    <actions>
        <group id="CloneGuardMenu" text="CloneGuard" description="CloneGuard actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="CloneGuard.ScanFile"
                    class="com.cloneguard.ui.ScanFileAction"
                    text="Scan Current File"
                    description="Scan the current file for all 4 clone types">
                <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl G"/>
            </action>

            <action id="CloneGuard.ScanProject"
                    class="com.cloneguard.ui.ScanProjectAction"
                    text="Scan Entire Project"
                    description="Scan every Java file in the project together for all 4 clone types">
                <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt G"/>
            </action>

            <action id="CloneGuard.IndexFile"
                    class="com.cloneguard.ui.IndexFileAction"
                    text="Index Current File"
                    description="Index functions in the current file for clone detection"/>

            <action id="CloneGuard.TestRealCompilation"
                    class="com.cloneguard.ui.TestRealCompilationAction"
                    text="Test: Real Compilation Check (throwaway)"
                    description="Isolated test of real-compile-based validation, not part of the real refactor flow"/>
        </group>
    </actions>

</idea-plugin>